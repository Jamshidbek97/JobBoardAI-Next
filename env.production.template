# Production Environment Variables
# Copy this file to .env.production and fill in your actual values

# Application
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# API URLs
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NEXT_PUBLIC_GRAPHQL_URL=https://yourdomain.com/graphql
NEXT_PUBLIC_WS_URL=wss://yourdomain.com/ws

# Database
DATABASE_URL=postgresql://jobboard_user:your_secure_password@postgres:5432/jobboard
POSTGRES_DB=jobboard
POSTGRES_USER=jobboard_user
POSTGRES_PASSWORD=your_secure_password

# Redis
REDIS_URL=redis://:your_redis_password@redis:6379
REDIS_PASSWORD=your_redis_password

# JWT
JWT_SECRET=your_super_secure_jwt_secret_key_here_minimum_32_chars

# SSL Certificate Paths (for Nginx)
SSL_CERT_PATH=./nginx/ssl/cert.pem
SSL_KEY_PATH=./nginx/ssl/key.pem

# Monitoring
PROMETHEUS_ENABLED=true
LOKI_ENABLED=true

# Security
SESSION_SECRET=your_session_secret_here
COOKIE_SECRET=your_cookie_secret_here

# Email (if using email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100
